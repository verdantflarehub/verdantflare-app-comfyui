ARG PYTHON_IMAGE=python:3.12.12-slim-bookworm
FROM ${PYTHON_IMAGE} AS source
WORKDIR /src
COPY upstream.lock.json ./
COPY frontend/ frontend/
COPY scripts/prepare_frontend.py scripts/prepare_runtime.py scripts/
RUN python scripts/prepare_frontend.py && python scripts/prepare_runtime.py

FROM ${PYTHON_IMAGE}
ARG RUNTIME_REQUIREMENTS=requirements-runtime.lock
ARG COMFYUI_DEVICE=cuda
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    COMFYUI_DEVICE=${COMFYUI_DEVICE} \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HOME=/workspace/cache/huggingface \
    XDG_CACHE_HOME=/workspace/cache NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 libgl1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 vf && useradd --uid 10001 --gid 10001 --no-create-home vf \
    && mkdir /workspace && chown 10001:10001 /workspace
WORKDIR /opt/vf
COPY ${RUNTIME_REQUIREMENTS} ./requirements-runtime.lock
RUN pip install --no-cache-dir --require-hashes -r requirements-runtime.lock
COPY --from=source /src/build/runtime/ /opt/comfyui/
COPY --from=source /src/build/frontend/ /opt/frontend/
COPY worker/ worker/
COPY upstream.lock.json UPSTREAM.md ./
USER 10001:10001
EXPOSE 8188
ENTRYPOINT ["python", "-m", "worker.container"]
